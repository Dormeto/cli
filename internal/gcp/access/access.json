{
  "version": 1,
  "apis": [
    "compute.googleapis.com",
    "run.googleapis.com",
    "firestore.googleapis.com",
    "cloudtasks.googleapis.com",
    "cloudscheduler.googleapis.com",
    "monitoring.googleapis.com",
    "artifactregistry.googleapis.com",
    "iam.googleapis.com",
    "cloudresourcemanager.googleapis.com",
    "logging.googleapis.com"
  ],
  "roles": {
    "dormetoRouter": {
      "title": "Dormeto router",
      "description": "Lets a Dormeto router read its workloads' load balancers, VMs and groups, update their URL maps, create and delete their waker backend services, turn their autoscalers off and back on, and read their request counts.",
      "permissions": [
        "compute.urlMaps.get",
        "compute.urlMaps.list",
        "compute.urlMaps.update",
        "compute.backendServices.get",
        "compute.backendServices.use",
        "compute.backendServices.create",
        "compute.backendServices.delete",
        "compute.regionNetworkEndpointGroups.use",
        "compute.globalForwardingRules.list",
        "compute.targetHttpProxies.list",
        "compute.targetHttpsProxies.list",
        "compute.instances.get",
        "compute.instanceGroups.get",
        "compute.instanceGroupManagers.get",
        "compute.autoscalers.get",
        "compute.autoscalers.update",
        "compute.machineTypes.get",
        "compute.globalOperations.get",
        "compute.zoneOperations.get",
        "compute.regionOperations.get",
        "monitoring.timeSeries.list",
        "compute.networkEndpointGroups.get",
        "compute.regionUrlMaps.get",
        "compute.regionUrlMaps.list",
        "compute.regionUrlMaps.update",
        "compute.regionBackendServices.get",
        "compute.regionBackendServices.use",
        "compute.regionBackendServices.create",
        "compute.regionBackendServices.delete",
        "compute.regionTargetHttpProxies.list",
        "compute.regionTargetHttpsProxies.list",
        "compute.forwardingRules.list"
      ]
    },
    "dormetoRouterBackends": {
      "title": "Dormeto router backends",
      "description": "Lets a Dormeto router start, stop, suspend and resume its workloads' VMs and managed instance groups, and change the machine type of a stopped VM. Granted on the condition that the resource has the tag dormeto=managed.",
      "permissions": [
        "compute.instances.start",
        "compute.instances.stop",
        "compute.instances.suspend",
        "compute.instances.resume",
        "compute.instances.setMachineType",
        "compute.instanceGroupManagers.update",
        "compute.instanceGroupManagers.use"
      ]
    }
  },
  "predefined": {
    "roles/datastore.user": [
      "datastore.entities.get",
      "datastore.entities.list",
      "datastore.entities.create",
      "datastore.entities.update",
      "datastore.entities.delete"
    ],
    "roles/logging.viewAccessor": [
      "logging.views.access"
    ],
    "roles/cloudtasks.enqueuer": [
      "cloudtasks.tasks.create"
    ],
    "roles/run.invoker": [
      "run.routes.invoke"
    ],
    "roles/iam.serviceAccountUser": [
      "iam.serviceAccounts.actAs"
    ]
  },
  "router": [
    {
      "role": "projects/{project}/roles/dormetoRouter",
      "on": "project"
    },
    {
      "role": "projects/{project}/roles/dormetoRouterBackends",
      "on": "project",
      "condition": {
        "title": "Dormeto-managed resources",
        "expression": "resource.matchTag('{project}/dormeto', 'managed')"
      }
    },
    {
      "role": "roles/datastore.user",
      "on": "project",
      "condition": {
        "title": "The router's database",
        "expression": "resource.name == \"projects/{project}/databases/{database}\""
      }
    },
    {
      "role": "roles/logging.viewAccessor",
      "on": "project",
      "condition": {
        "title": "The router's log view",
        "expression": "resource.name == \"projects/{project}/locations/global/buckets/_Default/views/dmtr-{region}-lb\""
      }
    },
    {
      "role": "roles/cloudtasks.enqueuer",
      "on": "queue"
    },
    {
      "role": "roles/run.invoker",
      "on": "controller"
    },
    {
      "role": "roles/iam.serviceAccountUser",
      "on": "serviceAccount"
    }
  ],
  "operator": {
    "check": {
      "read": [
        "resourcemanager.projects.get",
        "resourcemanager.projects.getIamPolicy",
        "serviceusage.services.list",
        "serviceusage.services.use"
      ]
    },
    "install": {
      "read": [
        "resourcemanager.projects.get",
        "resourcemanager.projects.getIamPolicy",
        "serviceusage.services.list",
        "serviceusage.services.use"
      ],
      "apis": [
        "serviceusage.services.enable",
        "serviceusage.operations.get"
      ],
      "roles": [
        "iam.roles.get",
        "iam.roles.create",
        "iam.roles.update",
        "iam.roles.undelete"
      ],
      "serviceAccount": [
        "iam.serviceAccounts.get",
        "iam.serviceAccounts.create",
        "iam.serviceAccounts.getIamPolicy",
        "iam.serviceAccounts.setIamPolicy",
        "iam.serviceAccounts.actAs"
      ],
      "projectBindings": [
        "resourcemanager.projects.getIamPolicy",
        "resourcemanager.projects.setIamPolicy"
      ],
      "tag": [
        "resourcemanager.tagKeys.create",
        "resourcemanager.tagKeys.get",
        "resourcemanager.tagValues.create",
        "resourcemanager.tagValues.get"
      ],
      "database": [
        "datastore.databases.create",
        "datastore.databases.get",
        "datastore.operations.get",
        "datastore.entities.create",
        "datastore.entities.get",
        "datastore.entities.update"
      ],
      "queue": [
        "cloudtasks.queues.create",
        "cloudtasks.queues.get",
        "cloudtasks.queues.update",
        "cloudtasks.queues.getIamPolicy",
        "cloudtasks.queues.setIamPolicy"
      ],
      "logView": [
        "logging.views.create",
        "logging.views.get",
        "logging.views.update"
      ]
    },
    "install-router": {
      "image": [
        "artifactregistry.repositories.get",
        "artifactregistry.repositories.downloadArtifacts",
        "artifactregistry.dockerimages.get"
      ],
      "cloudRun": [
        "run.services.create",
        "run.services.get",
        "run.services.update",
        "run.services.getIamPolicy",
        "run.services.setIamPolicy",
        "run.operations.get",
        "run.routes.invoke",
        "iam.serviceAccounts.actAs"
      ],
      "neg": [
        "compute.regionNetworkEndpointGroups.create",
        "compute.regionNetworkEndpointGroups.get",
        "compute.regionOperations.get"
      ],
      "job": [
        "cloudscheduler.jobs.create",
        "cloudscheduler.jobs.get",
        "cloudscheduler.jobs.update",
        "iam.serviceAccounts.actAs"
      ]
    },
    "uninstall": {
      "read": [
        "resourcemanager.projects.get",
        "resourcemanager.projects.getIamPolicy",
        "serviceusage.services.list",
        "serviceusage.services.use",
        "datastore.databases.list",
        "datastore.databases.get",
        "datastore.entities.get",
        "datastore.entities.list",
        "run.routes.invoke"
      ],
      "job": [
        "cloudscheduler.jobs.get",
        "cloudscheduler.jobs.delete"
      ],
      "neg": [
        "compute.regionNetworkEndpointGroups.get",
        "compute.regionNetworkEndpointGroups.delete",
        "compute.regionOperations.get"
      ],
      "cloudRun": [
        "run.services.get",
        "run.services.delete",
        "run.operations.get"
      ],
      "logView": [
        "logging.views.get",
        "logging.views.delete"
      ],
      "queue": [
        "cloudtasks.queues.get",
        "cloudtasks.queues.delete"
      ],
      "database": [
        "datastore.databases.get",
        "datastore.databases.delete",
        "datastore.operations.get"
      ],
      "projectBindings": [
        "resourcemanager.projects.getIamPolicy",
        "resourcemanager.projects.setIamPolicy"
      ],
      "tag": [
        "resourcemanager.tagKeys.get",
        "resourcemanager.tagKeys.delete",
        "resourcemanager.tagValues.get",
        "resourcemanager.tagValues.delete"
      ],
      "serviceAccount": [
        "iam.serviceAccounts.get",
        "iam.serviceAccounts.delete"
      ],
      "roles": [
        "iam.roles.get",
        "iam.roles.delete"
      ]
    },
    "workloads": {
      "invoke": [
        "run.routes.invoke"
      ]
    },
    "onboard": {
      "invoke": [
        "run.routes.invoke"
      ],
      "tag": [
        "resourcemanager.tagValues.get",
        "resourcemanager.tagValueBindings.create",
        "resourcemanager.tagValueBindings.delete",
        "compute.instances.listTagBindings",
        "compute.instances.createTagBinding",
        "compute.instances.deleteTagBinding",
        "compute.instanceGroupManagers.listTagBindings",
        "compute.instanceGroupManagers.createTagBinding",
        "compute.instanceGroupManagers.deleteTagBinding"
      ],
      "requestLogs": [
        "compute.backendServices.get",
        "compute.backendServices.update",
        "compute.regionBackendServices.get",
        "compute.regionBackendServices.update",
        "compute.globalOperations.get",
        "compute.regionOperations.get"
      ]
    },
    "offboard": {
      "invoke": [
        "run.routes.invoke"
      ],
      "tag": [
        "resourcemanager.tagValues.get",
        "resourcemanager.tagValueBindings.delete",
        "compute.instances.listTagBindings",
        "compute.instances.deleteTagBinding",
        "compute.instanceGroupManagers.listTagBindings",
        "compute.instanceGroupManagers.deleteTagBinding"
      ],
      "requestLogs": [
        "compute.backendServices.get",
        "compute.backendServices.update",
        "compute.regionBackendServices.get",
        "compute.regionBackendServices.update",
        "compute.globalOperations.get",
        "compute.regionOperations.get"
      ]
    },
    "connect": {
      "read": [
        "resourcemanager.projects.get",
        "resourcemanager.projects.getIamPolicy",
        "serviceusage.services.list",
        "serviceusage.services.use",
        "run.services.list"
      ],
      "apis": [
        "serviceusage.services.enable",
        "serviceusage.operations.get"
      ],
      "federation": [
        "iam.workloadIdentityPools.get",
        "iam.workloadIdentityPools.create",
        "iam.workloadIdentityPools.update",
        "iam.workloadIdentityPools.undelete",
        "iam.workloadIdentityPoolProviders.get",
        "iam.workloadIdentityPoolProviders.create",
        "iam.workloadIdentityPoolProviders.update",
        "iam.workloadIdentityPoolProviders.undelete"
      ],
      "serviceAccounts": [
        "iam.serviceAccounts.get",
        "iam.serviceAccounts.create",
        "iam.serviceAccounts.getIamPolicy",
        "iam.serviceAccounts.setIamPolicy"
      ],
      "roles": [
        "iam.roles.get",
        "iam.roles.create",
        "iam.roles.update",
        "iam.roles.undelete"
      ],
      "projectBindings": [
        "resourcemanager.projects.getIamPolicy",
        "resourcemanager.projects.setIamPolicy"
      ],
      "folderBindings": [
        "resourcemanager.folders.getIamPolicy",
        "resourcemanager.folders.setIamPolicy"
      ],
      "organizationBindings": [
        "resourcemanager.organizations.getIamPolicy",
        "resourcemanager.organizations.setIamPolicy"
      ],
      "controller": [
        "run.services.get",
        "run.services.getIamPolicy",
        "run.services.setIamPolicy"
      ],
      "tag": [
        "resourcemanager.tagValues.get",
        "resourcemanager.tagValues.getIamPolicy",
        "resourcemanager.tagValues.setIamPolicy"
      ]
    },
    "disconnect": {
      "read": [
        "resourcemanager.projects.get",
        "resourcemanager.projects.getIamPolicy",
        "serviceusage.services.list",
        "serviceusage.services.use",
        "run.services.list"
      ],
      "controller": [
        "run.services.get",
        "run.services.getIamPolicy",
        "run.services.setIamPolicy"
      ],
      "tag": [
        "resourcemanager.tagValues.get",
        "resourcemanager.tagValues.getIamPolicy",
        "resourcemanager.tagValues.setIamPolicy"
      ],
      "projectBindings": [
        "resourcemanager.projects.getIamPolicy",
        "resourcemanager.projects.setIamPolicy"
      ],
      "folderBindings": [
        "resourcemanager.folders.getIamPolicy",
        "resourcemanager.folders.setIamPolicy"
      ],
      "organizationBindings": [
        "resourcemanager.organizations.getIamPolicy",
        "resourcemanager.organizations.setIamPolicy"
      ],
      "roles": [
        "iam.roles.get",
        "iam.roles.delete"
      ],
      "serviceAccounts": [
        "iam.serviceAccounts.get",
        "iam.serviceAccounts.delete"
      ],
      "federation": [
        "iam.workloadIdentityPools.get",
        "iam.workloadIdentityPools.delete",
        "iam.workloadIdentityPoolProviders.get",
        "iam.workloadIdentityPoolProviders.delete"
      ]
    }
  },
  "features": {
    "cloud-sql": {
      "apis": [
        "sqladmin.googleapis.com"
      ],
      "roles": {
        "dormetoRouterDatabasesRead": {
          "title": "Dormeto router databases (read)",
          "description": "Lets a Dormeto router read its workloads' Cloud SQL instances: whether they run, their activation policy and their operations. Granted on the whole project; it changes nothing.",
          "permissions": [
            "cloudsql.instances.get",
            "cloudsql.instances.list"
          ]
        },
        "dormetoRouterDatabases": {
          "title": "Dormeto router databases",
          "description": "Lets a Dormeto router start and stop its workloads' Cloud SQL instances by changing their activation policy. Granted on the condition that the resource has the tag dormeto=managed.",
          "permissions": [
            "cloudsql.instances.update"
          ]
        }
      },
      "router": [
        {
          "role": "projects/{project}/roles/dormetoRouterDatabasesRead",
          "on": "project"
        },
        {
          "role": "projects/{project}/roles/dormetoRouterDatabases",
          "on": "project",
          "condition": {
            "title": "Dormeto-managed resources",
            "expression": "resource.matchTag('{project}/dormeto', 'managed')"
          }
        }
      ],
      "operator": {
        "onboard": {
          "tag": [
            "cloudsql.instances.get",
            "cloudsql.instances.listTagBindings",
            "cloudsql.instances.createTagBinding",
            "cloudsql.instances.deleteTagBinding",
            "datastore.entities.get"
          ]
        },
        "offboard": {
          "tag": [
            "cloudsql.instances.get",
            "cloudsql.instances.listTagBindings",
            "cloudsql.instances.deleteTagBinding"
          ]
        }
      }
    },
    "gke": {
      "apis": [
        "container.googleapis.com"
      ],
      "roles": {
        "dormetoRouterKubernetes": {
          "title": "Dormeto router Kubernetes",
          "description": "Lets a Dormeto router find a GKE cluster and connect to it. It grants nothing inside the cluster: what the router reads and scales there is the Role the operator applies.",
          "permissions": [
            "container.clusters.get",
            "container.clusters.connect"
          ]
        }
      },
      "router": [
        {
          "role": "projects/{project}/roles/dormetoRouterKubernetes",
          "on": "project"
        }
      ],
      "operator": {
        "onboard": {
          "cluster": [
            "container.clusters.get",
            "container.roles.create",
            "container.roles.update",
            "container.roleBindings.create",
            "container.roleBindings.update",
            "container.services.get",
            "container.roles.escalate",
            "container.roles.bind",
            "container.clusters.connect",
            "container.replicaSets.list",
            "container.pods.list",
            "container.roles.get",
            "container.roleBindings.get",
            "container.roles.delete",
            "container.roleBindings.delete",
            "datastore.databases.get",
            "datastore.entities.get",
            "datastore.entities.update"
          ]
        },
        "offboard": {
          "cluster": [
            "container.roles.delete",
            "container.roleBindings.delete",
            "container.roleBindings.update",
            "container.roles.bind",
            "container.clusters.connect",
            "container.clusters.get",
            "container.roles.get",
            "container.roleBindings.get",
            "datastore.databases.get",
            "datastore.entities.get",
            "datastore.entities.update"
          ]
        }
      }
    }
  },
  "manager": {
    "apis": [
      "iam.googleapis.com",
      "iamcredentials.googleapis.com",
      "sts.googleapis.com",
      "cloudresourcemanager.googleapis.com",
      "cloudbilling.googleapis.com"
    ],
    "federation": {
      "pool": "dmt-{env}",
      "provider": "aws-{account}",
      "condition": "assertion.arn.startsWith('arn:aws:sts::{account}:assumed-role/dmt-{env}-manager-')",
      "mapping": {
        "google.subject": "assertion.arn",
        "attribute.aws_role": "assertion.arn.extract('assumed-role/{role}/')"
      }
    },
    "serviceAccounts": {
      "discovery": "dmt-{env}-discovery",
      "command": "dmt-{env}-command"
    },
    "roles": {
      "dormetoDiscovery": {
        "title": "Dormeto manager discovery",
        "description": "Lets the Dormeto manager's discovery account read the projects, folders and organizations of its scopes, their load balancers, VMs and groups, their Cloud Run services and their request counts. Read only.",
        "permissions": [
          "resourcemanager.projects.get",
          "compute.urlMaps.get",
          "compute.urlMaps.list",
          "compute.regionUrlMaps.get",
          "compute.regionUrlMaps.list",
          "compute.backendServices.get",
          "compute.backendServices.list",
          "compute.regionBackendServices.get",
          "compute.regionBackendServices.list",
          "compute.targetHttpProxies.get",
          "compute.targetHttpProxies.list",
          "compute.targetHttpsProxies.get",
          "compute.targetHttpsProxies.list",
          "compute.regionTargetHttpProxies.get",
          "compute.regionTargetHttpProxies.list",
          "compute.regionTargetHttpsProxies.get",
          "compute.regionTargetHttpsProxies.list",
          "compute.globalForwardingRules.get",
          "compute.globalForwardingRules.list",
          "compute.forwardingRules.get",
          "compute.forwardingRules.list",
          "compute.instanceGroups.get",
          "compute.instanceGroups.list",
          "compute.instanceGroupManagers.get",
          "compute.instanceGroupManagers.list",
          "compute.instances.get",
          "compute.instances.list",
          "compute.networkEndpointGroups.get",
          "compute.networkEndpointGroups.list",
          "run.services.get",
          "run.services.list",
          "monitoring.timeSeries.list"
        ],
        "organizationPermissions": [
          "resourcemanager.folders.get",
          "resourcemanager.folders.list",
          "resourcemanager.organizations.get"
        ],
        "note": "organizationPermissions are added only where the role is defined in an organization: Google refuses folder and organization permissions in a role defined in a project."
      },
      "dormetoCommand": {
        "title": "Dormeto manager command",
        "description": "Lets the Dormeto manager's command account bind and unbind the managed tag on the compute resources and Cloud SQL instances of a router project. Granted with the invoker role on the controller and the tag user role on the tag value.",
        "permissions": [
          "compute.instances.listTagBindings",
          "compute.instances.createTagBinding",
          "compute.instances.deleteTagBinding",
          "compute.instanceGroupManagers.listTagBindings",
          "compute.instanceGroupManagers.createTagBinding",
          "compute.instanceGroupManagers.deleteTagBinding",
          "cloudsql.instances.get",
          "cloudsql.instances.listTagBindings",
          "cloudsql.instances.createTagBinding",
          "cloudsql.instances.deleteTagBinding"
        ]
      }
    },
    "grants": {
      "scopes": [
        {
          "account": "discovery",
          "role": "dormetoDiscovery",
          "on": "scope"
        }
      ],
      "routerProjects": [
        {
          "account": "command",
          "role": "roles/run.invoker",
          "on": "controller"
        },
        {
          "account": "command",
          "role": "roles/resourcemanager.tagUser",
          "on": "tagValue"
        },
        {
          "account": "command",
          "role": "dormetoCommand",
          "on": "project"
        }
      ]
    },
    "impersonation": {
      "role": "roles/iam.workloadIdentityUser",
      "principalSet": "principalSet://iam.googleapis.com/projects/{hostNumber}/locations/global/workloadIdentityPools/dmt-{env}/attribute.aws_role/{awsRole}",
      "discovery": [
        "dmt-{env}-manager-discovery",
        "dmt-{env}-manager-api",
        "dmt-{env}-manager-savings"
      ],
      "command": [
        "dmt-{env}-manager-operations",
        "dmt-{env}-manager-api",
        "dmt-{env}-manager-fleet"
      ],
      "note": "Granted on each service account to the principal set of each of its roles, and to no other. Whether roles/iam.workloadIdentityUser alone lets a principal set mint the ID token is measured live (M1); if not, roles/iam.serviceAccountOpenIdTokenCreator is added on the command account."
    }
  }
}
