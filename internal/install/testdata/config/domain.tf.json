{
  "module": {
    "dormeto": {
      "admin_emails": [
        "admin@example.com"
      ],
      "discovery_mode": "account",
      "domain": {
        "auth": "auth.dormeto.example.com",
        "certificate_arn": "arn:aws:acm:us-east-1:123456789012:certificate/abc-123",
        "dashboard": "dormeto.example.com",
        "zone_id": "Z123"
      },
      "email_from": "Dormeto <no-reply@example.com>",
      "env": "prod",
      "ses_identity": "example.com",
      "source": "./release/modules/manager"
    }
  },
  "output": {
    "dashboard_url": {
      "value": "${module.dormeto.dashboard_url}"
    },
    "user_pool_id": {
      "value": "${module.dormeto.user_pool_id}"
    },
    "version": {
      "value": "${module.dormeto.version}"
    }
  },
  "provider": {
    "aws": {
      "default_tags": {
        "tags": {
          "dormeto:env": "prod",
          "managed-by": "dormeto-cli",
          "project": "dormeto"
        }
      },
      "region": "eu-west-1"
    }
  },
  "terraform": {
    "backend": {
      "s3": {
        "bucket": "dmt-install-532105290256-eu-west-1",
        "encrypt": true,
        "key": "prod/manager.tfstate",
        "region": "eu-west-1",
        "use_lockfile": true
      }
    }
  }
}
